# ---------------------------------------------------------------------------
# Rickhouse configuration. Copy to `.env` next to docker-compose.yml and edit.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Used to build DATABASE_URL for the app and to initialise the db container.
# Changing POSTGRES_PASSWORD after first start does NOT change the password
# already stored in the volume — see "Changing the database password" in
# README.md.
POSTGRES_USER=rickhouse
POSTGRES_PASSWORD=change-me-to-something-long
POSTGRES_DB=rickhouse

# --- Accounts ---------------------------------------------------------------
# There is no shared password. On first start Rickhouse creates an admin
# account, prints a generated password to the container log once, and asks
# for a new password (and an email, unless ADMIN_EMAIL is set) at first
# sign-in. Admins create everyone else's accounts from Users, in the menu under
# their name (top right).
#
# Locked out? From the Unraid terminal (or anywhere Docker runs):
#   docker exec rickhouse-app node dist/reset-password.mjs <username-or-email>
# prints a new temporary password. Add --make-admin to promote the account.
ADMIN_USERNAME=admin
ADMIN_EMAIL=

# Signs session cookies. Minimum 32 characters. Generate one with:
#   openssl rand -hex 32
# Rotating this signs everyone out; it never needs to be memorable.
SESSION_SECRET=change-me-openssl-rand-hex-32-gives-you-64-characters-of-entropy

# How long a sign-in lasts.
SESSION_TTL_DAYS=30

# Set to true ONLY if you reach the app over HTTPS (reverse proxy, Tailscale
# with TLS, ...). On a plain-http LAN address it would stop the cookie being
# sent at all, which looks like "login does nothing".
COOKIE_SECURE=false

# --- Reverse proxy ----------------------------------------------------------
# The public address, e.g. https://rickhouse.example.com. Optional for now;
# single sign-on and emailed links will need it. Also set it if signing in
# through your proxy fails with "invalid origin" (some tunnels rewrite the
# Host header).
APP_URL=

# Sign-in attempts are rate limited per visitor IP, read from the
# X-Forwarded-For header your reverse proxy (Caddy, Nginx Proxy Manager,
# Traefik) adds. If something else sits in front of that proxy -- usually
# Cloudflare -- list its ranges here, comma-separated, or every visitor will
# look like Cloudflare: https://www.cloudflare.com/ips/
TRUSTED_PROXIES=

# --- Host paths (Unraid) ----------------------------------------------------
# Absolute host paths, on an Unraid box usually under /mnt/user/appdata.
# Defaults are relative folders so `docker compose up` works anywhere.
POSTGRES_DATA_PATH=./data/postgres
UPLOADS_PATH=./data/uploads
# Where automated backups (Admin -> Backups) and scripts/backup.sh's
# BACKUP_DIR both eventually land -- point it at a share that is actually
# part of your parity/backup plan.
BACKUP_PATH=./data/backups

# The host port the UI is served on. 1964: the year Congress declared
# bourbon a distinctive product of the United States.
APP_PORT=1964

# --- Image ------------------------------------------------------------------
# Which published image to run. `latest` tracks main; pin a version tag
# (e.g. 1.2.0) or a commit tag (e.g. sha-1a2b3c4) if you would rather update
# deliberately. Only used by the default, pull-based compose file.
RICKHOUSE_IMAGE=ghcr.io/zacharywelker/rickhouse
RICKHOUSE_TAG=latest

# --- Unraid file ownership --------------------------------------------------
# Unraid's shares are owned by nobody:users = 99:100. The app container drops
# to this uid/gid so bottle photos land on the share with usable ownership.
PUID=99
PGID=100
TZ=America/New_York

# --- Startup behaviour ------------------------------------------------------
# Migrations run on every start and are idempotent. The seed only inserts the
# Pursuit example while the collection is still empty.
RUN_MIGRATIONS=true
RUN_SEED=true
