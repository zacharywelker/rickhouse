# better-auth lists every framework it supports (SvelteKit, Solid, Vue, ...)
# as optional peers, and npm still tries to resolve their peer trees; SvelteKit
# wants vite 8 while vitest 3 pins vite 7. None of those frameworks are
# installed, so skip the check rather than upgrade the test runner to satisfy
# a package we never load.
#
# The cost: npm no longer installs peer dependencies on its own, so any peer
# a package needs has to be listed in package.json (react-is for recharts,
# vite for vitest).
legacy-peer-deps=true
