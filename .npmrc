# better-auth's packages (@better-auth/core, @better-auth/passkey) take
# better-call as a peer, and better-call optionally wants zod 4 while this app
# is on zod 3. A strict install refuses that with ERESOLVE, so skip the peer
# check until zod moves to 4.
#
# The cost: npm no longer installs peer dependencies on its own, so any peer
# a package needs has to be listed in package.json (react-is for recharts,
# vite for vitest).
legacy-peer-deps=true
